#Область ПрограммныйИнтерфейс

Функция ОтправитьСообщение(ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_ТокенУправленияТелеграмБотом.Получить();
	АдресРесурса = "/bot" + Токен + "/sendMessage";
	
	Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 15,
		Новый ЗащищенноеСоединениеOpenSSL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	
	ИдентификаторЧата = Константы.ВКМ_ИдентификаторЧатаТелеграм.Получить();
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("chat_id", ИдентификаторЧата);
	ДанныеОтвета.Вставить("text", ТекстСообщения);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	
	Результат = Соединение.ВызватьHTTPМетод("POST", Запрос);
	
	Если Результат.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации(
			"ВКМ.ОтправкаСообщенияТелеграм",
			УровеньЖурналаРегистрации.Ошибка,
			, ,
			Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;
	
	Возврат Результат.КодСостояния;
	
КонецФункции

Процедура ВКМ_ОтправкаУведомленийВТелеграм() Экспорт
	
	НакопленныеУведомления = ПолучитьНакопленныеУведомления();
	
	Для Каждого Уведомление Из НакопленныеУведомления Цикл
		
		Ответ = ОтправитьСообщение(Уведомление.Текст);
		Если Ответ = 200 Тогда
			Уведомление.Ссылка.ПолучитьОбъект().Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВКМ_ЗаписьОбслуживанияКлиентовПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Описание = ОписаниеИзмененийОбслуживания(Источник);
	Если ПустаяСтрока(Описание) Тогда
		Возврат;
	КонецЕсли;
	
	НовыйЭлемент = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.СоздатьЭлемент();
	НовыйЭлемент.Текст = Описание;
	НовыйЭлемент.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеИзмененийОбслуживания(Источник)
	
	Если Источник.ЭтоНовый() Тогда
		Возврат СтрШаблон("Создан документ «Обслуживание клиентов»: специалист %1, дата %2, время %3.",
			Строка(Источник.Специалист),
			Формат(Источник.Дата, "ДЛ=T"),
			Формат(Источник.ВремяНачалаРабот, "ДЛ=T"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВКМ_ОбслуживаниеКлиентов.Дата КАК Дата,
		|	ВКМ_ОбслуживаниеКлиентов.ВремяНачалаРабот,
		|	ВКМ_ОбслуживаниеКлиентов.Специалист КАК Специалист
		|ИЗ
		|	Документ.ВКМ_ОбслуживаниеКлиентов КАК ВКМ_ОбслуживаниеКлиентов
		|ГДЕ
		|	ВКМ_ОбслуживаниеКлиентов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	Изменения = Новый Массив;
	Если Выборка.Дата <> Источник.Дата Тогда
		Изменения.Добавить(СтрШаблон("дата изменена с %1 на %2",
			Формат(Выборка.Дата, "ДЛ=T"), Формат(Источник.Дата, "ДЛ=T")));
	КонецЕсли;
	Если Выборка.ВремяНачалаРабот <> Источник.ВремяНачалаРабот Тогда
		Изменения.Добавить(СтрШаблон("время изменено с %1 на %2",
			Формат(Выборка.ВремяНачалаРабот, "ДЛ=T"), Формат(Источник.ВремяНачалаРабот, "ДЛ=T")));
	КонецЕсли;
	Если Выборка.Специалист <> Источник.Специалист Тогда
		Изменения.Добавить(СтрШаблон("специалист изменён с %1 на %2",
			Строка(Выборка.Специалист), Строка(Источник.Специалист)));
	КонецЕсли;
	
	Если Изменения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон("Документ «Обслуживание клиентов» %1: %2.",
		Строка(Источник.Ссылка),
		СтрСоединить(Изменения, "; "));
	
КонецФункции

Функция ПолучитьНакопленныеУведомления()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_УведомленияТелеграмБотуДляОтправки.Текст КАК Текст,
	               |	ВКМ_УведомленияТелеграмБотуДляОтправки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВКМ_УведомленияТелеграмБотуДляОтправки КАК ВКМ_УведомленияТелеграмБотуДляОтправки";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


#КонецОбласти