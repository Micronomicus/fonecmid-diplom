Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;
	
	Движения.ВКМ_ОсновныеНачисления.Очистить();
	Движения.ВКМ_Удержания.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Очистить();
	
	МесяцНачисления = НачалоМесяца(Дата);
	КонецМесяцаНачисления = КонецМесяца(Дата);
	
	// ===== ПЕРВЫЙ ПРОХОД: Начисления =====
	Для Каждого СтрокаТЧ Из Сотрудники Цикл
		
		Сотрудник = СтрокаТЧ.Сотрудник;
		
		ЗапросУсловий = Новый Запрос;
		ЗапросУсловий.Текст = 
		"ВЫБРАТЬ
		|   Условия.Оклад КАК Оклад
		|ИЗ
		|   РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
		|       &МесяцНачисления,
		|       Сотрудник = &Сотрудник) КАК Условия";
		ЗапросУсловий.УстановитьПараметр("МесяцНачисления", МесяцНачисления);
		ЗапросУсловий.УстановитьПараметр("Сотрудник", Сотрудник);
		ВыборкаУсловий = ЗапросУсловий.Выполнить().Выбрать();
		
		Если Не ВыборкаУсловий.Следующий() Тогда
			Сообщить("Не заданы условия оплаты для " + Строка(Сотрудник));
			Продолжить;
		КонецЕсли;
		
		Оклад = ВыборкаУсловий.Оклад;
		
		ЕстьОтпуск = ЗначениеЗаполнено(СтрокаТЧ.ДатаНачала) 
		И ЗначениеЗаполнено(СтрокаТЧ.ДатаОкончания);
		
		Если Не ЕстьОтпуск Тогда
			
			// --- Оклад ---
			Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
			Движение.Сотрудник = Сотрудник;
			Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад;
			Движение.ПериодРегистрации = МесяцНачисления;
			Движение.ПериодДействияНачало = МесяцНачисления;
			Движение.ПериодДействияКонец = КонецМесяцаНачисления;
			Движение.Результат = Оклад;
			
			// --- Процент за работы ---
			ЗапросРабот = Новый Запрос;
			ЗапросРабот.Текст = 
			"ВЫБРАТЬ
			|   ЕСТЬNULL(СУММА(РаботыОбороты.СуммаКОплатеОборот), 0) КАК СуммаРабот,
			|   ЕСТЬNULL(СУММА(РаботыОбороты.ЧасовКОплатеОборот), 0) КАК Часов
			|ИЗ
			|   РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(
			|       &Начало, &Конец, , Сотрудник = &Сотрудник) КАК РаботыОбороты";
			ЗапросРабот.УстановитьПараметр("Начало", МесяцНачисления);
			ЗапросРабот.УстановитьПараметр("Конец", КонецМесяцаНачисления);
			ЗапросРабот.УстановитьПараметр("Сотрудник", Сотрудник);
			ВыборкаРабот = ЗапросРабот.Выполнить().Выбрать();            
			СуммаРабот = 0;
			Часов = 0;
			Если ВыборкаРабот.Следующий() Тогда
				СуммаРабот = ВыборкаРабот.СуммаРабот;
				Часов = ВыборкаРабот.Часов;
			КонецЕсли;
			
			Если СуммаРабот > 0 Тогда
				Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
				Движение.Сотрудник = Сотрудник;
				Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ПроцентЗаРаботы;
				Движение.ПериодРегистрации = МесяцНачисления;
				Движение.ПериодДействияНачало = МесяцНачисления;
				Движение.ПериодДействияКонец = КонецМесяцаНачисления;
				Движение.Результат = СуммаРабот;
			КонецЕсли;
			
			// Закрытие регистра работ
			Если Часов > 0 Тогда
				ДвижениеРасход = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
				ДвижениеРасход.Период = КонецМесяцаНачисления;
				ДвижениеРасход.Сотрудник = Сотрудник;
				ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
				ДвижениеРасход.ЧасовКОплате = Часов;
				ДвижениеРасход.СуммаКОплате = СуммаРабот;
			КонецЕсли;
			
		Иначе
			// --- Отпускные ---
			ДатаНачала12Мес = ДобавитьМесяц(МесяцНачисления, -12);
			
			ЗапросБазы = Новый Запрос;
			ЗапросБазы.Текст = 
			"ВЫБРАТЬ
			|   ЕСТЬNULL(СУММА(ОсновныеНачисления.Результат), 0) КАК СуммаЗаПериод
			|ИЗ
			|   РегистрРасчета.ВКМ_ОсновныеНачисления КАК ОсновныеНачисления
			|ГДЕ
			|   ОсновныеНачисления.Сотрудник = &Сотрудник
			|   И ОсновныеНачисления.ПериодРегистрации МЕЖДУ &ДатаНачала И &ДатаКонца
			|   И ОсновныеНачисления.ВидРасчета В
			|       (ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Оклад),
			|        ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.ПроцентЗаРаботы))";
			ЗапросБазы.УстановитьПараметр("Сотрудник", Сотрудник);
			ЗапросБазы.УстановитьПараметр("ДатаНачала", ДатаНачала12Мес);
			ЗапросБазы.УстановитьПараметр("ДатаКонца", МесяцНачисления);
			
			ВыборкаБазы = ЗапросБазы.Выполнить().Выбрать();
			СуммаЗаПериод = 0;
			Если ВыборкаБазы.Следующий() Тогда
				СуммаЗаПериод = ВыборкаБазы.СуммаЗаПериод;
			КонецЕсли;
			
			КоличествоРабочихДней = 12 * 21;
			КоличествоДнейОтпуска = (СтрокаТЧ.ДатаОкончания - СтрокаТЧ.ДатаНачала) / 86400 + 1;
			
			Отпускные = 0;
			Если КоличествоРабочихДней > 0 Тогда
				Отпускные = (СуммаЗаПериод / КоличествоРабочихДней) * КоличествоДнейОтпуска;
			КонецЕсли;
			
			Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
			Движение.Сотрудник = Сотрудник;
			Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск;
			Движение.ПериодРегистрации = МесяцНачисления;
			Движение.ПериодДействияНачало = СтрокаТЧ.ДатаНачала;
			Движение.ПериодДействияКонец = СтрокаТЧ.ДатаОкончания;
			Движение.Результат = Отпускные;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Записываем начисления — они нужны как база для расчёта НДФЛ
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
	// ===== ВТОРОЙ ПРОХОД: НДФЛ по виртуальной таблице База =====
	
	// 1. Заготовки удержаний с нулевым результатом
	//    (НомерСтроки не заполняем — платформа проставит его при записи набора)
	Для Каждого СтрокаТЧ Из Сотрудники Цикл
		Сотрудник = СтрокаТЧ.Сотрудник;
		
		ЕстьНачисления = Ложь;
		Для Каждого Запись Из Движения.ВКМ_ОсновныеНачисления Цикл
			Если Запись.Сотрудник = Сотрудник Тогда
				ЕстьНачисления = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьНачисления Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ВКМ_Удержания.Добавить();
		Движение.Сотрудник = Сотрудник;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Движение.ПериодРегистрации = МесяцНачисления;
		Движение.ПериодДействияНачало = МесяцНачисления;
		Движение.ПериодДействияКонец = КонецМесяцаНачисления;
		Движение.Результат = 0;
	КонецЦикла;
	
	Движения.ВКМ_Удержания.Записать();
	
	// 2. База — виртуальная таблица База регистра Удержаний
	//    Параметры таблицы База: измерения основного регистра,
	//    измерения базового регистра, разрезы, условие.
	Измерения = Новый Массив(1);
	Измерения[0] = "Сотрудник";
	
	ЗапросНДФЛ = Новый Запрос;
	ЗапросНДФЛ.Текст =
	"ВЫБРАТЬ
	|   База.Сотрудник КАК Сотрудник,
	|   ЕСТЬNULL(СУММА(База.РезультатБаза), 0) КАК СуммаБазы
	|ИЗ
	|   РегистрРасчета.ВКМ_Удержания.БазаВКМ_ОсновныеНачисления(
	|       &Измерения,
	|       &Измерения,
	|       ,
	|       Регистратор = &Регистратор) КАК База
	|
	|СГРУППИРОВАТЬ ПО
	|   База.Сотрудник";
	
	ЗапросНДФЛ.УстановитьПараметр("Измерения", Измерения);
	ЗапросНДФЛ.УстановитьПараметр("Регистратор", Ссылка);
	
	ВыборкаНДФЛ = ЗапросНДФЛ.Выполнить().Выбрать();
	
	Пока ВыборкаНДФЛ.Следующий() Цикл
		
		Для Каждого ЗаписьУдержания Из Движения.ВКМ_Удержания Цикл
			Если ЗаписьУдержания.Сотрудник = ВыборкаНДФЛ.Сотрудник Тогда
				ЗаписьУдержания.Результат = Окр(ВыборкаНДФЛ.СуммаБазы * 13 / 100, 2);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Движения.ВКМ_Удержания.Записать();
	
	// ===== Взаиморасчёты по суммам, зарегистрированным этим документом =====
	Для Каждого СтрокаТЧ Из Сотрудники Цикл
		
		Сотрудник = СтрокаТЧ.Сотрудник;
		
		СуммаНачислений = 0;
		Для Каждого Запись Из Движения.ВКМ_ОсновныеНачисления Цикл
			Если Запись.Сотрудник = Сотрудник Тогда
				СуммаНачислений = СуммаНачислений + Запись.Результат;
			КонецЕсли;
		КонецЦикла;
		
		СуммаУдержаний = 0;
		Для Каждого Запись Из Движения.ВКМ_Удержания Цикл
			Если Запись.Сотрудник = Сотрудник Тогда
				СуммаУдержаний = СуммаУдержаний + Запись.Результат;
			КонецЕсли;
		КонецЦикла;
		
		Если СуммаНачислений = 0 Тогда
			Продолжить; // сотруднику ничего не начислено — взаиморасчёты не трогаем
		КонецЕсли;
		
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.Период = МесяцНачисления;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Сотрудник = Сотрудник;
		Движение.Сумма = СуммаНачислений - СуммаУдержаний;
		
	КонецЦикла;
	
КонецПроцедуры
