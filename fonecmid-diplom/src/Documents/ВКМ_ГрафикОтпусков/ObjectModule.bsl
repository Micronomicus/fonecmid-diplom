
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ВКМ_ГрафикОтпусков.Записывать = Истина;
	Движения.ВКМ_ГрафикОтпусков.Очистить();
	
	Для Каждого Строка Из ОтпускаСотрудников Цикл
		
		Запись = Движения.ВКМ_ГрафикОтпусков.Добавить();
		Запись.Период = НачалоГода(Строка.ДатаНачала);
		Запись.ВКМ_Сотрудник = Строка.Сотрудник;
		Запись.ВКМ_ДатаНачала = Строка.ДатаНачала;
		Запись.ВКМ_ДатаОкончания = Строка.ДатаОкончания;
		Запись.ВКМ_ЧислоДнейОтпуска = Строка.ЧислоДней;
		
	КонецЦикла;
	
КонецПроцедуры