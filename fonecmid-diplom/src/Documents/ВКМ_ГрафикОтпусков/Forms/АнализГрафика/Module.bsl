&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("АдресДанных") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОтпусков = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
	
	Элементы.ДиаграммаГанта.Точки.Очистить();
	
	Для Каждого СтрокаТЧ Из ДанныеОтпусков Цикл
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Сотрудник) 
			И ЗначениеЗаполнено(СтрокаТЧ.ДатаНачала) 
			И ЗначениеЗаполнено(СтрокаТЧ.ДатаОкончания) Тогда
			
			Точка = Элементы.ДиаграммаГанта.Точки.Добавить(СтрокаТЧ.Сотрудник);
			
			Интервал = Точка.Интервалы.Добавить();
			Интервал.Начало = СтрокаТЧ.ДатаНачала;
			Интервал.Конец = СтрокаТЧ.ДатаОкончания;
			Интервал.Текст = "Отпуск";
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры