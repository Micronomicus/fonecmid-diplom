#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
 
 	Запрос = Новый Запрос(
	  "ВЫБРАТЬ
	  |	ДоговорыКонтрагентов.ВидДоговора,
	  |	ДоговорыКонтрагентов.ВКМ_ДатаНачалаДействияДоговора,
	  |	ДоговорыКонтрагентов.ВКМ_ДатаОкончанияДействияДоговора,
	  |	ДоговорыКонтрагентов.ВКМ_СтоимостьЧасаРаботыСпециалиста
	  |ИЗ
	  |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	  |ГДЕ
	  |	ДоговорыКонтрагентов.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Договор); 
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	СообщениеТекст = "";
	Если Выборка.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		Если Дата < Выборка.ВКМ_ДатаНачалаДействияДоговора Тогда
			СообщениеТекст = "Дата документа ранее даты начала действия договора";
		ИначеЕсли Дата > Выборка.ВКМ_ДатаОкончанияДействияДоговора Тогда
			СообщениеТекст = "Дата документа позже даты окончания действия договора";
		КонецЕсли;
	Иначе
		СообщениеТекст = "Вид договора не абонентское обслуживание";
	КонецЕсли;
	
	Если ПустаяСтрока(СообщениеТекст) Тогда 
		КоличествоЧасовДробь = (ВремяОкончанияРабот - ВремяНачалаРабот) / 3600;
		КоличествоЧасов = Цел(КоличествоЧасовДробь);
		Если КоличествоЧасов < КоличествоЧасовДробь Тогда
			КоличествоЧасов = КоличествоЧасов + 1;
		КонецЕсли;
		
		// --- Движение по ВКМ_ВыполненныеКлиентуРаботы ---
		Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
		Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.КоличествоЧасов = КоличествоЧасов;
		Движение.СуммаКОплате = КоличествоЧасов * Выборка.ВКМ_СтоимостьЧасаРаботыСпециалиста;	
		
		// --- Движение по ВКМ_ВыполненныеСотрудникомРаботы ---
		ЗапросПроцент = Новый Запрос;
		ЗапросПроцент.Текст = 
			"ВЫБРАТЬ
			|	Условия.ПроцентОтРабот КАК ПроцентОтРабот
			|ИЗ
			|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
			|		&Дата,
			|		Сотрудник = &Специалист) КАК Условия";
		ЗапросПроцент.УстановитьПараметр("Дата", Дата);
		ЗапросПроцент.УстановитьПараметр("Специалист", Специалист); 
		
		РезультатПроцент = ЗапросПроцент.Выполнить();
		
		Если РезультатПроцент.Пустой() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Специалисту " + Специалист + " не установлен процент от работ на дату документа";
			Сообщение.Сообщить();
			Отказ = Истина;
		Иначе
			ВыборкаПроцент = РезультатПроцент.Выбрать();
			ВыборкаПроцент.Следующий();
			ПроцентОтРабот = ВыборкаПроцент.ПроцентОтРабот;
			
			СуммаКОплате = КоличествоЧасов * Выборка.ВКМ_СтоимостьЧасаРаботыСпециалиста * ПроцентОтРабот / 100;
			
			Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;
			Движение = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
			Движение.Период = Дата;
			Движение.Сотрудник = Специалист; 
			Движение.ЧасовКОплате = КоличествоЧасов;
			Движение.СуммаКОплате = СуммаКОплате;
		КонецЕсли;
		
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СообщениеТекст;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписи(Отказ)
	
	СимволыПС = Символы.ПС;
	ФорматВремени = "ДЛФ=В";
	СообщениеТекст = "";
	
	Если Ссылка.Пустая() Тогда
		ПустаяДата = Дата('00010101');
		СообщениеТекст = СтрШаблон("Новый документ. Дата: %1", Дата);
		Если ДатаПроведенияРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Дата проведения работ: %3", СообщениеТекст, СимволыПС, ДатаПроведенияРабот);
		КонецЕсли;
		Если ВремяНачалаРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Время начала работ: %3", СообщениеТекст, СимволыПС, Формат(ВремяНачалаРабот, ФорматВремени));
		КонецЕсли;
		Если ВремяОкончанияРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Время окончания работ: %3", СообщениеТекст, СимволыПС, Формат(ВремяОкончанияРабот, ФорматВремени));
		КонецЕсли;
		Если Не ПустаяСтрока(Специалист) Тогда
			СообщениеТекст = СтрШаблон("%1%2Специалист: %3", СообщениеТекст, СимволыПС, Специалист);
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВКМ_ОбслуживаниеКлиентов.Дата,
		|	ВКМ_ОбслуживаниеКлиентов.ДатаПроведенияРабот,
		|	ВКМ_ОбслуживаниеКлиентов.ВремяНачалаРабот,
		|	ВКМ_ОбслуживаниеКлиентов.ВремяОкончанияРабот,
		|	ВКМ_ОбслуживаниеКлиентов.Специалист
		|ИЗ
		|	Документ.ВКМ_ОбслуживаниеКлиентов КАК ВКМ_ОбслуживаниеКлиентов
		|ГДЕ
		|	ВКМ_ОбслуживаниеКлиентов.Ссылка = &Ссылка
		|	И НЕ (ВКМ_ОбслуживаниеКлиентов.Дата = &Дата
		|	И ВКМ_ОбслуживаниеКлиентов.ДатаПроведенияРабот = &ДатаПроведенияРабот
		|	И ВКМ_ОбслуживаниеКлиентов.ВремяНачалаРабот = &ВремяНачалаРабот
		|	И ВКМ_ОбслуживаниеКлиентов.ВремяОкончанияРабот = &ВремяОкончанияРабот
		|	И ВКМ_ОбслуживаниеКлиентов.Специалист = &Специалист)";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("ДатаПроведенияРабот", ДатаПроведенияРабот);
		Запрос.УстановитьПараметр("ВремяНачалаРабот", ВремяНачалаРабот);
		Запрос.УстановитьПараметр("ВремяОкончанияРабот", ВремяОкончанияРабот);
		Запрос.УстановитьПараметр("Специалист", Специалист);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СообщениеТекст = "Документ изменен:";
			Если Выборка.Дата <> Дата Тогда
				СообщениеТекст = СтрШаблон("%1%2Предыдущая дата: %3 Новая дата: %4", СообщениеТекст, СимволыПС, Выборка.Дата, Дата);
			КонецЕсли;
			Если Выборка.ДатаПроведенияРабот <> ДатаПроведенияРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старая дата проведения работ: %3 Новая дата проведения работ: %4", СообщениеТекст, СимволыПС, Выборка.ДатаПроведенияРабот, ДатаПроведенияРабот);
			КонецЕсли;
			Если Выборка.ВремяНачалаРабот <> ВремяНачалаРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старое время начала работ: %3 Новое время начала работ: %4", СообщениеТекст, СимволыПС, Формат(Выборка.ВремяНачалаРабот, ФорматВремени), Формат(ВремяНачалаРабот, ФорматВремени));
			КонецЕсли;
			Если Выборка.ВремяОкончанияРабот <> ВремяОкончанияРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старое время окончания работ: %3 Новое время окончания работ: %4", СообщениеТекст, СимволыПС, Формат(Выборка.ВремяОкончанияРабот, ФорматВремени), Формат(ВремяОкончанияРабот, ФорматВремени));
			КонецЕсли;
			Если Выборка.Специалист <> Специалист Тогда
				СообщениеТекст = СтрШаблон("%1%2Предыдущий специалист: %3 Текущий специалист: %4", СообщениеТекст, СимволыПС, Выборка.Специалист, Специалист);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(СообщениеТекст) Тогда
		НовыйЭлемент = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.СоздатьЭлемент();
		НовыйЭлемент.Текст = СообщениеТекст;
		НовыйЭлемент.Записать();
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#КонецЕсли