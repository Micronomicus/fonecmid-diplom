
&НаКлиенте
Процедура Формировать(Команда)
	
	ДлительнаяОперация = НачатьФормирование();
	
	Если ДлительнаяОперация.Статус <> "Выполняется" Тогда
		Если ДлительнаяОперация.Статус = "Ошибка" Тогда
			Сообщить("Формирование не запущено: " + ДлительнаяОперация.КраткоеПредставлениеОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Элементы.Формировать.Доступность = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДлительнаяОперация,
		Новый ОписаниеОповещения("ФормированиеЗавершено", ЭтотОбъект));
	
КонецПроцедуры
&НаСервере
Функция НачатьФормирование()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ВКМ_МассовоеСозданиеДокументовСервер.СформироватьДокументы",
		Объект.Период);
	
КонецФункции

&НаКлиенте
Процедура ФормированиеЗавершено(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.Формировать.Доступность = Истина;
	
	Если Результат = Неопределено Тогда
		Возврат; // задание отменено при закрытии формы
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Сообщить("Формирование не выполнено: " + Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаСообщения Из Результат.Сообщения Цикл
		Сообщить(Строка(СтрокаСообщения));
	КонецЦикла;
	
	ДанныеВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ЗаполнитьСписокНаСервере(ДанныеВыполнения.Созданные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере(Созданные)
	
	Для Каждого СтрокаДанных Из Созданные Цикл
		НоваяСтрока = Объект.СписокДоговоровИСсылок.Добавить();
		НоваяСтрока.Договор    = СтрокаДанных.Договор;
		НоваяСтрока.Реализация = СтрокаДанных.Реализация;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)	
	Месяцы = Новый Массив(12);
    Месяцы[0] = "январь";
    Месяцы[1] = "февраль";
    Месяцы[2] = "март";
    Месяцы[3] = "апрель";
    Месяцы[4] = "май";
    Месяцы[5] = "июнь";
    Месяцы[6] = "июль";
    Месяцы[7] = "август";
    Месяцы[8] = "сентябрь";
    Месяцы[9] = "октябрь";
    Месяцы[10] = "ноябрь";
    Месяцы[11] = "декабрь";
	Элементы.Период.ФорматРедактирования = СтрШаблон("ДФ='''%1'' yyyy'", Месяцы[Месяц(Объект.Период) - 1]);

КонецПроцедуры